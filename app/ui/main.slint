import { ScrollView } from "std-widgets.slint";
import { Theme, Choice } from "theme.slint";
import {
    Card, ListCard, SectionHeader, OpRow, ToggleRow, LabeledToggle,
    NavBar, PrimaryButton, ResultCard, OpDetail, PickerSheet,
} from "components.slint";
import { Field, SegmentedField, PickerRow } from "inputs.slint";

export component MainWindow inherits Window {
    title: "HDM";
    background: Theme.bg;
    min-width: 320px;
    min-height: 480px;
    preferred-width: 420px;
    preferred-height: 880px;

    // Safe-area insets. Slint does not auto-inset on iOS, so reserve generous opaque space for the
    // status bar / Dynamic Island (top) and home indicator (bottom). Exposed so a future native
    // layer can set exact per-device values.
    in-out property <length> safe-top: 59px;
    in-out property <length> safe-bottom: 34px;

    // Navigation: "" = home, "settings", "privacy", or an operation key.
    in-out property <string> nav: "";

    // ---- language (active translation code: "en" / "ru" / "hy") ----
    in-out property <string> language: "en";
    callback language-changed(string);
    changed language => {
        root.language-changed(self.language);
    }

    // ---- connection ----
    in-out property <string> host: "192.168.1.5";
    in-out property <string> port: "1025";
    in-out property <string> timeout-seconds: "50";
    in-out property <string> password: "";
    in-out property <string> cashier: "";
    in-out property <string> pin: "";
    in-out property <bool> demo-mode: false;

    // ---- operation inputs ----
    in-out property <string> receipt-mode: "simple";
    in-out property <string> amount: "";
    in-out property <string> card-amount: "";
    in-out property <string> partial-amount: "";
    in-out property <string> prepayment-amount: "";
    in-out property <string> department: "";
    in-out property <string> partner-tin: "";
    in-out property <string> payment-system: "";
    in-out property <bool> use-ext-pos: false;
    in-out property <string> rrn: "";
    in-out property <string> terminal-id: "";
    in-out property <string> crn: "";
    in-out property <string> receipt-id: "";
    in-out property <string> ticket: "";
    in-out property <string> emarks: "";
    in-out property <string> json-path: "";
    in-out property <string> logo-path: "";
    in-out property <string> description: "";
    in-out property <bool> cash-in: true;
    in-out property <string> report-kind: "x";
    in-out property <string> report-filter-kind: "";
    in-out property <string> report-filter-value: "";
    in-out property <string> report-start: "0";
    in-out property <string> report-end: "0";
    in-out property <bool> confirm-operation: false;

    // ---- power-user toggle: reveal raw fields / manual entry ----
    in-out property <bool> advanced: false;

    // ---- device-backed choice models (populated by the Rust bridge) ----
    in property <[Choice]> operator-choices: [];
    in property <[Choice]> department-choices: [];
    in property <[Choice]> payment-choices: [];

    // ---- static enum choices ----
    property <[Choice]> mode-choices: [
        { key: "simple", label: @tr("choice.mode.simple") },
        { key: "products", label: @tr("choice.mode.products") },
        { key: "prepayment", label: @tr("choice.mode.prepay") },
    ];
    property <[Choice]> report-kind-choices: [
        { key: "x", label: @tr("choice.report.x") },
        { key: "z", label: @tr("choice.report.z") },
    ];
    property <[Choice]> filter-kind-choices: [
        { key: "", label: @tr("choice.filter.none") },
        { key: "dept", label: @tr("choice.filter.dept") },
        { key: "cashier", label: @tr("choice.filter.operator") },
        { key: "transaction", label: @tr("choice.filter.txn") },
    ];
    property <[Choice]> language-choices: [
        { key: "en", label: "English" },
        { key: "ru", label: "Русский" },
        { key: "hy", label: "Հայերեն" },
    ];

    // ---- modal picker state ----
    // "" closed, else "cashier" / "department" / "payment" / "filter-dept" / "filter-cashier".
    in-out property <string> picker-kind: "";
    in-out property <bool> picker-busy: false;
    in-out property <string> picker-note: "";

    property <[Choice]> sheet-choices:
        (root.picker-kind == "cashier" || root.picker-kind == "filter-cashier")
            ? root.operator-choices
            : ((root.picker-kind == "department" || root.picker-kind == "filter-dept")
                ? root.department-choices
                : root.payment-choices);
    property <string> sheet-current:
        root.picker-kind == "cashier" ? root.cashier
        : root.picker-kind == "department" ? root.department
        : root.picker-kind == "payment" ? root.payment-system
        : root.report-filter-value;
    property <string> sheet-title:
        root.picker-kind == "cashier" ? @tr("sheet.select_operator")
        : root.picker-kind == "department" ? @tr("sheet.select_department")
        : root.picker-kind == "payment" ? @tr("sheet.select_payment")
        : root.picker-kind == "filter-cashier" ? @tr("sheet.filter_operator")
        : @tr("sheet.filter_department");

    // ---- status ----
    in-out property <bool> busy: false;
    in-out property <string> status: "Ready";
    in-out property <string> detail: "Choose an operation.";
    in-out property <string> last-result: "";

    // ---- callbacks (consumed by the Rust bridge) ----
    callback probe-requested();
    callback operators-requested();
    callback login-requested();
    callback receipt-requested();
    callback print-last-requested();
    callback lookup-requested();
    callback header-footer-requested();
    callback logo-requested();
    callback report-requested();
    callback return-requested();
    callback cash-requested();
    callback datetime-requested();
    callback sample-requested();
    callback time-sync-requested();
    callback payment-systems-requested();
    callback emark-requested();
    callback privacy-requested();
    // populate operator-choices + department-choices (password op)
    callback load-directory-requested();
    // populate payment-choices (session op)
    callback load-payments-requested();

    // Clears focus when the user taps empty space -> dismisses the soft keyboard.
    bg-tap := TouchArea {
        clicked => {
            keyboard-sink.focus();
        }
    }

    keyboard-sink := FocusScope {
        width: 0px;
        height: 0px;
    }

    VerticalLayout {
        // ---- top safe area ----
        Rectangle {
            height: root.safe-top;
            background: Theme.bg;
        }

        // ---- screen area ----
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;

            // ===================== HOME =====================
            if root.nav == "": VerticalLayout {
                HorizontalLayout {
                    padding-left: Theme.gap;
                    padding-right: 8px;
                    height: 56px;
                    Text {
                        text: "HDM";
                        color: Theme.ink;
                        font-size: 34px;
                        font-weight: 800;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    gear := TouchArea {
                        width: 48px;
                        clicked => {
                            root.nav = "settings";
                        }
                        Text {
                            text: "⚙";
                            font-size: 26px;
                            color: gear.pressed ? Theme.accent.darker(0.2) : Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                home-sv := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: home-sv.visible-width;
                        alignment: start;
                        padding: Theme.gap;
                        padding-top: 4px;
                        spacing: 22px;

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.connection");
                            }
                            ListCard {
                                OpRow {
                                    title: @tr("home.connection_settings");
                                    subtitle: root.host + ":" + root.port;
                                    clicked => {
                                        root.nav = "settings";
                                    }
                                }
                                ToggleRow {
                                    title: @tr("home.demo");
                                    on <=> root.demo-mode;
                                    enabled-state: !root.busy;
                                    last: true;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.diagnostics");
                            }
                            ListCard {
                                OpRow {
                                    title: @tr("op.probe.title");
                                    clicked => {
                                        root.nav = "probe";
                                    }
                                }
                                OpRow {
                                    title: @tr("home.operators");
                                    clicked => {
                                        root.nav = "operators";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.login.title");
                                    clicked => {
                                        root.nav = "login";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.datetime.title");
                                    clicked => {
                                        root.nav = "datetime";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.payments.title");
                                    last: true;
                                    clicked => {
                                        root.nav = "payments";
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.receipts");
                            }
                            ListCard {
                                OpRow {
                                    title: @tr("op.receipt.title");
                                    clicked => {
                                        root.nav = "receipt";
                                    }
                                }
                                OpRow {
                                    title: @tr("home.print_last");
                                    clicked => {
                                        root.nav = "print-last";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.lookup.title");
                                    clicked => {
                                        root.nav = "lookup";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.return.title");
                                    last: true;
                                    clicked => {
                                        root.nav = "return";
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.reports");
                            }
                            ListCard {
                                OpRow {
                                    title: @tr("home.report");
                                    clicked => {
                                        root.nav = "report";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.cash.title");
                                    last: true;
                                    clicked => {
                                        root.nav = "cash";
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.device");
                            }
                            ListCard {
                                OpRow {
                                    title: @tr("op.header_footer.title");
                                    clicked => {
                                        root.nav = "header-footer";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.logo.title");
                                    clicked => {
                                        root.nav = "logo";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.sample.title");
                                    clicked => {
                                        root.nav = "sample";
                                    }
                                }
                                OpRow {
                                    title: @tr("home.time_sync");
                                    clicked => {
                                        root.nav = "time-sync";
                                    }
                                }
                                OpRow {
                                    title: @tr("op.emark.title");
                                    last: true;
                                    clicked => {
                                        root.nav = "emark";
                                    }
                                }
                            }
                        }

                        OpRow {
                            title: @tr("op.privacy.title");
                            clicked => {
                                root.privacy-requested();
                                root.nav = "privacy";
                            }
                        }

                        Rectangle {
                            height: 16px;
                        }
                    }
                }
            }

            // ===================== SETTINGS =====================
            if root.nav == "settings": VerticalLayout {
                NavBar {
                    title: @tr("settings.title");
                    back => {
                        root.nav = "";
                    }
                }
                set-sv := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: set-sv.visible-width;
                        alignment: start;
                        padding: Theme.gap;
                        spacing: Theme.gap;

                        Card {
                            Field {
                                label: @tr("field.host");
                                value <=> root.host;
                                placeholder: "192.168.1.5";
                                enabled-state: !root.busy && !root.demo-mode;
                            }
                            Field {
                                label: @tr("field.port");
                                value <=> root.port;
                                placeholder: "1025";
                                numeric: true;
                                enabled-state: !root.busy && !root.demo-mode;
                            }
                            Field {
                                label: @tr("field.timeout");
                                value <=> root.timeout-seconds;
                                placeholder: "50";
                                numeric: true;
                                enabled-state: !root.busy && !root.demo-mode;
                            }
                            Field {
                                label: @tr("field.password");
                                value <=> root.password;
                                placeholder: @tr("ph.hdm_password");
                                secret: true;
                                enabled-state: !root.busy && !root.demo-mode;
                            }
                        }

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.operator");
                            }
                            if !root.advanced: ListCard {
                                PickerRow {
                                    label: @tr("field.operator");
                                    placeholder: @tr("ph.choose_operator");
                                    choices: root.operator-choices;
                                    value: root.cashier;
                                    enabled-state: !root.busy && !root.demo-mode;
                                    last: true;
                                    open => {
                                        keyboard-sink.focus();
                                        root.picker-note = "";
                                        root.picker-kind = "cashier";
                                    }
                                }
                            }
                            if root.advanced: Card {
                                Field {
                                    label: @tr("field.cashier_id");
                                    value <=> root.cashier;
                                    placeholder: "3";
                                    numeric: true;
                                    enabled-state: !root.busy && !root.demo-mode;
                                }
                            }
                            Card {
                                Field {
                                    label: @tr("field.pin");
                                    value <=> root.pin;
                                    placeholder: "1234";
                                    secret: true;
                                    numeric: true;
                                    enabled-state: !root.busy && !root.demo-mode;
                                }
                            }
                            PrimaryButton {
                                text: root.picker-busy ? @tr("common.loading") : @tr("settings.load_directory");
                                enabled-state: !root.busy && !root.demo-mode && !root.picker-busy;
                                clicked => {
                                    keyboard-sink.focus();
                                    root.load-directory-requested();
                                }
                            }
                            if root.picker-note != "": Text {
                                text: root.picker-note;
                                color: Theme.sub;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }

                        Card {
                            LabeledToggle {
                                label: @tr("settings.advanced");
                                on <=> root.advanced;
                                enabled-state: !root.busy;
                            }
                            LabeledToggle {
                                label: @tr("settings.demo");
                                on <=> root.demo-mode;
                                enabled-state: !root.busy;
                            }
                        }

                        VerticalLayout {
                            spacing: 7px;
                            SectionHeader {
                                text: @tr("section.language");
                            }
                            Card {
                                SegmentedField {
                                    options: root.language-choices;
                                    value <=> root.language;
                                    enabled-state: !root.busy;
                                }
                            }
                        }

                        Rectangle {
                            height: 24px;
                        }
                    }
                }
            }

            // ===================== PRIVACY =====================
            if root.nav == "privacy": VerticalLayout {
                NavBar {
                    title: @tr("op.privacy.title");
                    back => {
                        root.nav = "";
                    }
                }
                priv-sv := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: priv-sv.visible-width;
                        alignment: start;
                        padding: Theme.gap;
                        spacing: Theme.gap;
                        Card {
                            Text {
                                text: root.last-result;
                                color: Theme.ink;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {
                            height: 24px;
                        }
                    }
                }
            }

            // ===================== OPERATIONS =====================
            if root.nav == "probe": OpDetail {
                title: @tr("op.probe.title");
                description: @tr("op.probe.desc");
                run-label: @tr("op.probe.run");
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.probe-requested(); }
            }

            if root.nav == "operators": OpDetail {
                title: @tr("op.operators.title");
                description: @tr("op.operators.desc");
                run-label: @tr("op.operators.run");
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.operators-requested(); }
            }

            if root.nav == "login": OpDetail {
                title: @tr("op.login.title");
                description: @tr("op.login.desc");
                run-label: @tr("op.login.title");
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.login-requested(); }
            }

            if root.nav == "datetime": OpDetail {
                title: @tr("op.datetime.title");
                description: @tr("op.datetime.desc");
                run-label: @tr("op.datetime.run");
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.datetime-requested(); }
            }

            if root.nav == "payments": OpDetail {
                title: @tr("op.payments.title");
                description: @tr("op.payments.desc");
                run-label: @tr("op.payments.run");
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.payment-systems-requested(); }
            }

            if root.nav == "receipt": OpDetail {
                title: @tr("op.receipt.title");
                description: @tr("op.receipt.desc");
                run-label: @tr("op.receipt.title");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.receipt-requested(); }

                Card {
                    SegmentedField {
                        label: @tr("field.mode");
                        options: root.mode-choices;
                        value <=> root.receipt-mode;
                        enabled-state: !root.busy;
                    }
                }

                Card {
                    Field {
                        label: @tr("field.cash");
                        value <=> root.amount;
                        placeholder: "0.00";
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.card");
                        value <=> root.card-amount;
                        placeholder: "0.00";
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.partial");
                        value <=> root.partial-amount;
                        placeholder: "0.00";
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.prepayment");
                        value <=> root.prepayment-amount;
                        placeholder: "0.00";
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                }

                if !root.advanced: ListCard {
                    PickerRow {
                        label: @tr("field.department");
                        placeholder: @tr("ph.choose_department");
                        choices: root.department-choices;
                        value: root.department;
                        enabled-state: !root.busy;
                        last: true;
                        open => {
                            keyboard-sink.focus();
                            root.picker-note = "";
                            root.picker-kind = "department";
                        }
                    }
                }
                if root.advanced: Card {
                    Field {
                        label: @tr("field.department_id");
                        value <=> root.department;
                        placeholder: "1";
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                }

                if root.receipt-mode == "products": Card {
                    Field {
                        label: @tr("field.items_json");
                        value <=> root.json-path;
                        placeholder: "items.json";
                        enabled-state: !root.busy;
                    }
                }

                if root.advanced: Card {
                    Field {
                        label: @tr("field.partner_tin");
                        value <=> root.partner-tin;
                        placeholder: @tr("ph.partner_tin");
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                }

                if root.advanced: VerticalLayout {
                    spacing: 7px;
                    SectionHeader {
                        text: @tr("section.payment");
                    }
                    ListCard {
                        PickerRow {
                            label: @tr("field.payment_system");
                            placeholder: @tr("ph.device_default");
                            choices: root.payment-choices;
                            value: root.payment-system;
                            enabled-state: !root.busy && !root.use-ext-pos;
                            last: true;
                            open => {
                                keyboard-sink.focus();
                                root.picker-note = "";
                                root.picker-kind = "payment";
                            }
                        }
                    }
                    Card {
                        LabeledToggle {
                            label: @tr("field.ext_pos");
                            on <=> root.use-ext-pos;
                            enabled-state: !root.busy;
                        }
                        if root.use-ext-pos: Field {
                            label: @tr("field.rrn");
                            value <=> root.rrn;
                            placeholder: @tr("ph.rrn12");
                            enabled-state: !root.busy;
                        }
                        if root.use-ext-pos: Field {
                            label: @tr("field.terminal_id");
                            value <=> root.terminal-id;
                            placeholder: @tr("ph.term8");
                            enabled-state: !root.busy;
                        }
                    }
                    Card {
                        Field {
                            label: @tr("field.emarks");
                            value <=> root.emarks;
                            placeholder: @tr("ph.optional");
                            enabled-state: !root.busy;
                        }
                    }
                }
            }

            if root.nav == "print-last": OpDetail {
                title: @tr("op.print_last.title");
                description: @tr("op.print_last.desc");
                run-label: @tr("home.print_last");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.print-last-requested(); }
            }

            if root.nav == "lookup": OpDetail {
                title: @tr("op.lookup.title");
                description: @tr("op.lookup.desc");
                run-label: @tr("op.lookup.run");
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.lookup-requested(); }
                Card {
                    Field {
                        label: @tr("field.crn");
                        value <=> root.crn;
                        placeholder: "51815332";
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.receipt_id");
                        value <=> root.receipt-id;
                        placeholder: @tr("ph.receipt_number");
                        enabled-state: !root.busy;
                    }
                }
            }

            if root.nav == "return": OpDetail {
                title: @tr("op.return.title");
                description: @tr("op.return.desc");
                run-label: @tr("op.return.run");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.return-requested(); }
                Card {
                    Field {
                        label: @tr("field.crn");
                        value <=> root.crn;
                        placeholder: "51815332";
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.ticket");
                        value <=> root.ticket;
                        placeholder: @tr("ph.receipt_number");
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.cash_return");
                        value <=> root.amount;
                        placeholder: @tr("ph.optional_full");
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.card_return");
                        value <=> root.card-amount;
                        placeholder: @tr("ph.optional");
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.prepayment_return");
                        value <=> root.prepayment-amount;
                        placeholder: @tr("ph.optional");
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.rrn");
                        value <=> root.rrn;
                        placeholder: @tr("ph.optional");
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.terminal_id");
                        value <=> root.terminal-id;
                        placeholder: @tr("ph.optional");
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.emarks");
                        value <=> root.emarks;
                        placeholder: @tr("ph.optional");
                        enabled-state: !root.busy;
                    }
                    if root.advanced: Field {
                        label: @tr("field.peritem_json");
                        value <=> root.json-path;
                        placeholder: @tr("ph.optional");
                        enabled-state: !root.busy;
                    }
                }
            }

            if root.nav == "report": OpDetail {
                title: @tr("op.report.title");
                description: @tr("op.report.desc");
                run-label: root.report-kind == "z" ? @tr("op.report.run_z") : @tr("op.report.run_x");
                side-effect: root.report-kind == "z";
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.report-requested(); }

                Card {
                    SegmentedField {
                        label: @tr("field.report_kind");
                        options: root.report-kind-choices;
                        value <=> root.report-kind;
                        enabled-state: !root.busy;
                    }
                    SegmentedField {
                        label: @tr("field.filter");
                        options: root.filter-kind-choices;
                        value <=> root.report-filter-kind;
                        enabled-state: !root.busy;
                    }
                }

                if root.report-filter-kind == "dept": ListCard {
                    PickerRow {
                        label: @tr("field.department");
                        placeholder: @tr("ph.choose_department");
                        choices: root.department-choices;
                        value: root.report-filter-value;
                        enabled-state: !root.busy;
                        last: true;
                        open => {
                            keyboard-sink.focus();
                            root.picker-note = "";
                            root.picker-kind = "filter-dept";
                        }
                    }
                }
                if root.report-filter-kind == "cashier": ListCard {
                    PickerRow {
                        label: @tr("field.operator");
                        placeholder: @tr("ph.choose_operator");
                        choices: root.operator-choices;
                        value: root.report-filter-value;
                        enabled-state: !root.busy;
                        last: true;
                        open => {
                            keyboard-sink.focus();
                            root.picker-note = "";
                            root.picker-kind = "filter-cashier";
                        }
                    }
                }
                if root.report-filter-kind == "transaction": Card {
                    Field {
                        label: @tr("field.transaction_type");
                        value <=> root.report-filter-value;
                        placeholder: @tr("ph.type_code");
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                }

                if root.advanced: Card {
                    Field {
                        label: @tr("field.start");
                        value <=> root.report-start;
                        placeholder: "0";
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.end");
                        value <=> root.report-end;
                        placeholder: "0";
                        numeric: true;
                        enabled-state: !root.busy;
                    }
                }
            }

            if root.nav == "cash": OpDetail {
                title: @tr("op.cash.title");
                description: @tr("op.cash.desc");
                run-label: @tr("op.cash.run");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.cash-requested(); }
                Card {
                    LabeledToggle {
                        label: @tr("field.cash_in");
                        on <=> root.cash-in;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.amount");
                        value <=> root.amount;
                        placeholder: "0.00";
                        decimal-kb: true;
                        enabled-state: !root.busy;
                    }
                    Field {
                        label: @tr("field.description");
                        value <=> root.description;
                        placeholder: @tr("ph.optional_note");
                        enabled-state: !root.busy;
                    }
                }
            }

            if root.nav == "header-footer": OpDetail {
                title: @tr("op.header_footer.title");
                description: @tr("op.header_footer.desc");
                run-label: @tr("op.header_footer.run");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.header-footer-requested(); }
                Card {
                    Field {
                        label: @tr("field.json_path");
                        value <=> root.json-path;
                        placeholder: "header-footer.json";
                        enabled-state: !root.busy;
                    }
                }
            }

            if root.nav == "logo": OpDetail {
                title: @tr("op.logo.title");
                description: @tr("op.logo.desc");
                run-label: @tr("op.logo.run");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.logo-requested(); }
                Card {
                    Field {
                        label: @tr("field.logo_path");
                        value <=> root.logo-path;
                        placeholder: "logo.bmp";
                        enabled-state: !root.busy;
                    }
                }
            }

            if root.nav == "sample": OpDetail {
                title: @tr("op.sample.title");
                description: @tr("op.sample.desc");
                run-label: @tr("op.sample.run");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.sample-requested(); }
            }

            if root.nav == "time-sync": OpDetail {
                title: @tr("op.time_sync.title");
                description: @tr("op.time_sync.desc");
                run-label: @tr("op.time_sync.run");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.time-sync-requested(); }
            }

            if root.nav == "emark": OpDetail {
                title: @tr("op.emark.title");
                description: @tr("op.emark.desc");
                run-label: @tr("op.emark.title");
                side-effect: true;
                confirm <=> root.confirm-operation;
                demo: root.demo-mode;
                busy: root.busy;
                status: root.status;
                detail: root.detail;
                result: root.last-result;
                back => { root.nav = ""; }
                run => { root.emark-requested(); }
                Card {
                    Field {
                        label: @tr("field.emark_code");
                        value <=> root.emarks;
                        placeholder: @tr("ph.emark_len");
                        enabled-state: !root.busy;
                    }
                }
            }
        }

        // ---- bottom safe area ----
        Rectangle {
            height: root.safe-bottom;
            background: Theme.bg;
        }
    }

    // ---- modal selection sheet (on top of everything) ----
    PickerSheet {
        open: root.picker-kind != "";
        title: root.sheet-title;
        choices: root.sheet-choices;
        current: root.sheet-current;
        loadable: true;
        busy: root.picker-busy;
        note: root.picker-note;
        safe-bottom: root.safe-bottom;
        pick(key) => {
            if (root.picker-kind == "cashier") {
                root.cashier = key;
            } else if (root.picker-kind == "department") {
                root.department = key;
            } else if (root.picker-kind == "payment") {
                root.payment-system = key;
            } else {
                root.report-filter-value = key;
            }
            root.picker-kind = "";
        }
        refresh => {
            if (root.picker-kind == "payment") {
                root.load-payments-requested();
            } else {
                root.load-directory-requested();
            }
        }
        cancel => {
            root.picker-kind = "";
        }
    }
}
