{
  "name": "@hdm-am/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript/TypeScript packages and apps for the HDM bridge.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.4.0",
  "scripts": {
    "gen": "pnpm -r --if-present run gen",
    "gen:check": "pnpm -r --if-present run gen:check",
    "regen": "node scripts/regen.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "pack:check": "pnpm --filter @hdm-am/client run pack:check && pnpm --filter @hdm-am/react run pack:check",
    "verify": "pnpm run gen:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
